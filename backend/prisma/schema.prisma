generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     Int       @id @default(autoincrement())
  fullName               String
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  isAdmin                Boolean   @default(false) @map("is_admin")
  avatarUrl              String?   @map("avatar_url")
  bio                    String    @default("")
  expertiseTags          String[]  @default([]) @map("expertise_tags")
  rating                 Float     @default(0)
  isMentorProfileComplete Boolean @default(false) @map("is_mentor_profile_complete")
  notificationPrefs      Json?     @map("notification_prefs")
  suspended              Boolean   @default(false)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  mentorRequestsSent     MentorshipRequest[] @relation("MenteeRequests")
  menteeRequestsReceived MentorshipRequest[] @relation("MentorRequests")
  mentorSessions         Session[]           @relation("SessionMentor")
  menteeSessions         Session[]           @relation("SessionMentee")
  availability           Availability?
  posts                  Post[]
  comments               Comment[]
  postReactions          PostReaction[]
  stories                Story[]
  storyComments          StoryComment[]
  sentMessages           Message[]
  notifications          Notification[]
  reviewsGiven           Review[]            @relation("ReviewMentee")
  reviewsReceived        Review[]            @relation("ReviewMentor")
  reports                Report[]
  conversationParticipants ConversationParticipant[]
  passwordResets          PasswordReset[]

  @@map("users")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("password_resets")
}

model MentorshipRequest {
  id        Int      @id @default(autoincrement())
  mentorId  Int      @map("mentor_id")
  menteeId  Int      @map("mentee_id")
  message   String
  duration  String
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mentor User @relation("MentorRequests", fields: [mentorId], references: [id])
  mentee User @relation("MenteeRequests", fields: [menteeId], references: [id])

  @@map("mentorship_requests")
}

model Session {
  id           Int      @id @default(autoincrement())
  mentorId     Int      @map("mentor_id")
  menteeId     Int      @map("mentee_id")
  title        String
  date         String
  time         String
  status       String   @default("upcoming")
  videoCallUrl String?  @map("video_call_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  mentor User @relation("SessionMentor", fields: [mentorId], references: [id])
  mentee User @relation("SessionMentee", fields: [menteeId], references: [id])

  @@map("sessions")
}

model Availability {
  id        Int  @id @default(autoincrement())
  mentorId  Int  @unique @map("mentor_id")
  slots     Json

  mentor User @relation(fields: [mentorId], references: [id])

  @@map("availability")
}

model Post {
  id           Int      @id @default(autoincrement())
  authorId     Int      @map("author_id")
  content      String
  mediaUrl     String?  @map("media_url")
  mediaType    String?  @map("media_type")
  commentCount Int      @default(0) @map("comment_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  author   User           @relation(fields: [authorId], references: [id])
  comments Comment[]
  reactions PostReaction[]

  @@map("posts")
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  authorId  Int      @map("author_id")
  parentId  Int?     @map("parent_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

model PostReaction {
  id     Int  @id @default(autoincrement())
  postId Int  @map("post_id")
  userId Int  @map("user_id")
  type   String

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@map("post_reactions")
}

model Conversation {
  id          Int      @id @default(autoincrement())
  type        String   @default("direct")
  groupName   String?  @map("group_name")
  groupIconUrl String? @map("group_icon_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  messages     Message[]
  participants ConversationParticipant[]
}

model ConversationParticipant {
  id             Int @id @default(autoincrement())
  conversationId Int @map("conversation_id")
  userId         Int @map("user_id")

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  senderId       Int       @map("sender_id")
  text           String    @default("")
  messageType    String    @default("text") @map("message_type")
  attachmentUrl  String?   @map("attachment_url")
  sentAt         DateTime  @default(now()) @map("sent_at")
  readAt         DateTime? @map("read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String
  message   String
  read      Boolean  @default(false)
  linkTo    String?  @map("link_to")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Report {
  id         Int      @id @default(autoincrement())
  type       String
  status     String   @default("pending")
  reportedBy Int      @map("reported_by")
  targetType String   @map("target_type")
  targetId   Int      @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  reporter User @relation(fields: [reportedBy], references: [id])

  @@map("reports")
}

model Review {
  id        Int      @id @default(autoincrement())
  mentorId  Int      @map("mentor_id")
  menteeId  Int      @map("mentee_id")
  rating    Float
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  mentor User @relation("ReviewMentor", fields: [mentorId], references: [id])
  mentee User @relation("ReviewMentee", fields: [menteeId], references: [id])

  @@unique([mentorId, menteeId])
  @@map("reviews")
}

model Story {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  mediaUrl  String?  @map("media_url")
  mediaType String   @default("image") @map("media_type")
  caption   String   @default("")
  text      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user     User           @relation(fields: [userId], references: [id])
  comments StoryComment[]

  @@map("stories")
}

model StoryComment {
  id        Int      @id @default(autoincrement())
  storyId   Int      @map("story_id")
  authorId  Int      @map("author_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@map("story_comments")
}
